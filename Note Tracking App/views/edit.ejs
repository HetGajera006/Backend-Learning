<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editing: <%= filename %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-zinc-900 text-white min-h-screen p-10 font-sans">
    
    <div class="max-w-3xl mx-auto mt-10">
        <a href="/" class="inline-flex items-center text-zinc-400 hover:text-blue-400 transition-colors mb-6 text-sm font-medium">
            Go Back Home
        </a>
    
        <form action="/edit" method="POST" class="bg-zinc-800 p-8 rounded-xl shadow-md border border-zinc-700">
            <h1 class="text-2xl font-bold mb-6 text-blue-400">Edit Note Title</h1>
            
            <div class="mb-4">
                <label class="block text-zinc-400 text-sm mb-2">Previous Title</label>
                <input
                    type="text"
                    name="Previous"
                    required
                    value="<%= filename %>"
                    readonly
                    class=" rounded-md w-full p-3 bg-zinc-900 text-zinc-500 rounded-md outline-none cursor-not-allowed border border-zinc-700"
                >
            </div>
            
            <div class="mb-6">
                <label class="block text-zinc-400 text-sm mb-2">New Title</label>
                <input
                    type="text"
                    name="new"
                    placeholder="Enter new title here..."
                    required
                    class="rounded-md w-full p-3 bg-zinc-700 text-white rounded-md outline-none focus:ring-2 focus:ring-blue-500 border border-zinc-600"
                >
            </div>
            
            <button
                type="submit"
                class="bg-yellow-600 hover:bg-yellow-700 text-white px-5 py-2 rounded-md transition"
            >
                Update Name
            </button>
        </form>
    </div>

</body>
</html>