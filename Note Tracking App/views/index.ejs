<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Note Taking App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-zinc-900 text-white min-h-screen p-10">

    <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold mb-8">Note Taking App</h1>

        <form action="/create" method="POST" class="bg-zinc-800 p-6 rounded-lg mb-10 shadow-md">
            <div class="mb-4">
                <input
                    type="text"
                    name="title"
                    placeholder="Note Title"
                    required
                    class="w-full p-3 bg-zinc-700 text-white rounded-md outline-none focus:ring-2 focus:ring-blue-500"
                >
            </div>
            <div class="mb-4">
                <textarea
                    name="details"
                    placeholder="Write your note details here..."
                    rows="4"
                    required
                    class="w-full p-3 bg-zinc-700 text-white rounded-md outline-none focus:ring-2 focus:ring-blue-500 resize-none"
                ></textarea>
            </div>
            <button
                type="submit"
                class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-md transition"
            >
                Create Note
            </button>
        </form>

        <h2 class="text-2xl font-semibold mb-4">Your Notes</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <% if (files.length === 0) { %>
                <p class="text-zinc-500 col-span-full">No tasks yet. Create one above!</p>
            <% } else { %>
                <% files.forEach(function(file) { %>
                    <div class="bg-zinc-800 p-5 rounded-lg shadow-md border border-zinc-700">
                        <h3 class="text-xl font-medium text-blue-400 mb-2 truncate"><%= file %></h3>
                        <p class="text-zinc-400 text-sm">Stored as a <code>.txt</code> file in backend.</p>
                        <a href="/file/<%= file %>" class="text-blue-500 hover:underline">Read More.</a>
                        
                        <div class="flex items-center gap-3 flex">
                            <form action="/delete/<%= file %>" method="POST" class="mt-3" onsubmit="return confirm('Are you sure you want to delete this?')">
                            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white py-1 px-3 rounded transition">Delete</button>
                            <a href="/edit/<%= file %>" class="mt-3 text-white bg-blue-500 hover:bg-blue-600 py-1 px-3 rounded transition">Edit FileName</a>
                        </form>
                            
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>

</body>
</html>