<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <a href="/logout" class="bg-red-500 hover:bg-red-600 rounded-md px-3 py-2 inline-block float-right">
            Logout
        </a>

        <div class="pt-15">

            <h1 class="text-2xl text-zinc-300 mb-5">Edit Your post.</h1>

            <form action="/update/<%= post._id %>" method="post">
                <textarea name="content" placeholder="What's on your mind?" required
                    class="mt-3 p-3 w-full md:w-[466px] h-16 block bg-transparent border border-zinc-700 rounded-md outline-none resize-none focus:border-zinc-500"><%= post.content %></textarea>

                <input type="submit" value="Edit Post"
                    class="bg-yellow-700 hover:bg-blue-600 rounded-md text-white block mt-2 px-4 py-2 cursor-pointer" />
            </form>
        </div>
    </div>
</body>

</html>