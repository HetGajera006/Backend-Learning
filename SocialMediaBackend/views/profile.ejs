<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <a href="/logout" class="bg-red-500 hover:bg-red-600 rounded-md px-3 py-2 inline-block float-right">
            Logout
        </a>

        <div class="pt-15">
            <h2 class="text-3xl mb-1">Hello <%= user.name %> 👋🏻</h2>

            <p class="text-sm text-zinc-300 mb-5">You can create a new post.</p>

            <form action="/post" method="post">
                <textarea name="content" placeholder="What's on your mind?" required
                    class="mt-3 p-3 w-full md:w-[466px] h-16 block bg-transparent border border-zinc-700 rounded-md outline-none resize-none focus:border-zinc-500"></textarea>

                <input type="submit" value="Create New Post"
                    class="bg-blue-500 hover:bg-blue-600 rounded-md text-white block mt-2 px-4 py-2 cursor-pointer" />
            </form>

            <div class="posts mt-16">
                <h3 class="text-zinc-300 text-sm">Your Posts.</h3>

                <div class="postcontainer mt-4 w-full md:w-[466px]">
                    <% if(user.post.length > 0) { %>
                        <% user.post.reverse().forEach(function(post) { %>
                            <div class="post bg-zinc-800 border border-zinc-700 rounded-md p-3 mb-3">
                                <h4 class="text-blue-400 text-sm mb-2">@<%= user.username %></h4>

                                <p class="text-sm text-zinc-200 leading-5">
                                    <%= post.content %>
                                </p>

                                <div class="buttons mt-4">
                                    <a href="#" class="text-blue-400 text-sm mr-3 hover:underline">
                                        Like
                                    </a>
                                    <a href="#" class="text-zinc-500 text-sm hover:text-zinc-300">
                                        Edit
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-zinc-500 text-sm mt-4">You haven't posted anything yet.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>