<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-800 p-10 text-white">
        <form action="/create" method="post" class="flex flex-col gap-3 w-1/3">
            <h2 class="text-3xl mb-5">Create Account</h2>
            <input class="px-3 py-2 outline-none border-2 rounded-lg border-zinc-600 bg-transparent" type="text" placeholder="Name" name="name">
            <input class="px-3 py-2 outline-none border-2 rounded-lg border-zinc-600 bg-transparent" type="text" placeholder="Username" name="username">
            <input class="px-3 py-2 outline-none border-2 rounded-lg border-zinc-600 bg-transparent" type="email" placeholder="Email" name="email">
            <input class="px-3 py-2 outline-none border-2 rounded-lg border-zinc-600 bg-transparent" type="number" placeholder="Age" name="age">
            <input class="px-3 py-2 outline-none border-2 rounded-lg border-zinc-600 bg-transparent" type="password" placeholder="Password" name="password">
            <input type="submit" value="Create Account" class="bg-blue-500 px-3 py-2 rounded-lg cursor-pointer hover:bg-blue-600">
            <p class="text-sm mt-3 text-zinc-400">Already have an account? <a href="/login" class="text-blue-500 hover:underline">Log in</a></p>
        </form>
    </div>
</body>
</html>